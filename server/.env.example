# Port the HTTP server listens on
PORT=3000

# Secret token required by adapter clients (Claude Code, Copilot CLI)
# Header: Authorization: Bearer <ADAPTER_SECRET>
ADAPTER_SECRET=change-me-adapter-secret

# Secret token required for the Hark callback webhook
# Header: Authorization: Bearer <CALLBACK_SECRET>
CALLBACK_SECRET=change-me-callback-secret

# Token for WebSocket connections from the Expo app
# Query param: /ws?token=<WS_TOKEN>
WS_TOKEN=change-me-ws-token

# Hark webhook token — get this from your Hark account
HARK_WEBHOOK_TOKEN=your-hark-webhook-token

# Public URL of this server (used in Hark callback webhook URL)
SERVER_URL=https://your-server.up.railway.app

# Deep link base URL for the Expo app (used in Hark notification)
APP_DEEP_LINK=remoteapproval://
