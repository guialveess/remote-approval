{
  "expo": {
    "name": "Remote Approval",
    "slug": "remote-approval",
    "version": "1.0.0",
    "scheme": "remoteapproval",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0a",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.remoteapproval.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.remoteapproval.app"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "32a5f6cd-2732-41a4-b261-3fccf02ee67a"
      }
    }
  }
}
